Cell[BoxData[
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"t", "=", "3"}], ";", "\[IndentingNewLine]", 
    RowBox[{"analytical", " ", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"Re", "[", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"ux", "/.", 
            RowBox[{"a", "\[Rule]", "t"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", 
             RowBox[{"-", "1"}], ",", "1", ",", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", 
             RowBox[{"-", "1"}], ",", "1", ",", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"p", ",", 
             RowBox[{"-", "1"}], ",", "1", ",", "2"}], "}"}]}], "]"}], "]"}], 
        "2"], "+", 
       SuperscriptBox[
        RowBox[{"Re", "[", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"uy", "/.", 
            RowBox[{"a", "\[Rule]", "t"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", 
             RowBox[{"-", "1"}], ",", "1", ",", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", 
             RowBox[{"-", "1"}], ",", "1", ",", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"p", ",", 
             RowBox[{"-", "1"}], ",", "1", ",", "2"}], "}"}]}], "]"}], "]"}], 
        "2"]}], "]"}]}], ";", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"analytical", "-", 
       RowBox[{
        RowBox[{"ihat", "[", 
         RowBox[{"[", 
          RowBox[{"t", "+", "1"}], "]"}], "]"}], "[", 
        RowBox[{"x", ",", "y"}], "]"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"Max", "[", 
       RowBox[{
        RowBox[{"Abs", "[", "analytical", "]"}], ",", 
        RowBox[{"10", "^", 
         RowBox[{"-", "8"}]}]}], "]"}], ")"}]}]}], ",", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}], "\[Element]", "smallRegion"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "0.1"}]}], "]"}]], "Input",
