Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"2", "nd", " ", "order"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", "h", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f1", "=", 
     RowBox[{
      RowBox[{"Expand", "[", 
       RowBox[{"2", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"h", "/", "2"}], "-", "x"}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{"h", "-", "x"}], ")"}]}], "]"}], "/", 
      RowBox[{"h", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f2", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"4", "x", "*", "h"}], "-", 
        RowBox[{"4", "*", 
         RowBox[{"x", "^", "2"}]}]}], ")"}], "/", 
      RowBox[{"h", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f3", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "*", 
         RowBox[{"x", "^", "2"}]}], "-", 
        RowBox[{"x", "*", "h"}]}], ")"}], "/", 
      RowBox[{"h", "^", "2"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"f1", "=", 
      RowBox[{"1", "-", 
       RowBox[{"x", "/", "h"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"f2", "=", 
      RowBox[{
       RowBox[{"-", "4"}], "x", "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", "h"}], ")"}], "/", 
        RowBox[{"h", "^", "2"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"f3", "=", 
      RowBox[{"x", "/", "h"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f", "=", 
     RowBox[{"{", 
      RowBox[{"f1", ",", "f2", ",", "f3"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Kloc", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"-", 
