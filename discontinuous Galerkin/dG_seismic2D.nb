Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Print", "[", "\"\<LEAP FROG SHEME, DO NOT DELETE!\>\"", "]"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"leapFrogScheme", "[", 
   RowBox[{"nodes_", ",", "elements_", ",", "\[Tau]_", ",", "Tmax_"}], "]"}], 
  ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "stepsCount", ",", "Av", ",", "Bv", ",", "Cv", ",", "A\[Sigma]", ",", 
      "B\[Sigma]", ",", "C\[Sigma]", ",", "dots", ",", "Dx", ",", "Dy", ",", 
      "Ax", ",", "Axv", ",", "Ax\[Sigma]", ",", "Ay", ",", "Ayv", ",", 
      "Ay\[Sigma]", ",", "i", ",", "j", ",", "nj", ",", "Anv", ",", 
      "An\[Sigma]", ",", "R", ",", "Kpv", ",", "Kp\[Sigma]", ",", "Wv", ",", 
      "W\[Sigma]", ",", "t"}], "}"}], ",", 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"neighbours", "=", 
       RowBox[{"tri2Tri", "[", 
        RowBox[{"nodes", ",", "elements"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"stepsCount", "=", 
       RowBox[{"Ceiling", "[", 
        RowBox[{"Tmax", "/", "\[Tau]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "elements", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Av", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", "n", ",", 
         RowBox[{"3", "*", "2"}], ",", 
         RowBox[{"3", "*", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Bv", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", "n", ",", 
         RowBox[{"3", "*", "2"}], ",", 
         RowBox[{"3", "*", "3"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Cv", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", "n", ",", "3", ",", 
         RowBox[{"3", "*", "2"}], ",", 
         RowBox[{"3", "*", "3"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"A\[Sigma]", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", "n", ",", 
         RowBox[{"3", "*", "3"}], ",", 
         RowBox[{"3", "*", "3"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"B\[Sigma]", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", "n", ",", 
         RowBox[{"3", "*", "3"}], ",", 
         RowBox[{"3", "*", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"C\[Sigma]", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", "n", ",", "3", ",", 
         RowBox[{"3", "*", "3"}], ",", 
         RowBox[{"3", "*", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "\[LessEqual]", "n"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dots", "=", 
          RowBox[{"nodes", "[", 
           RowBox[{"[", 
            RowBox[{"elements", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Av", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "+=", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{
            RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", 
            RowBox[{"calculateLocalM0", "[", "dots", "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"A\[Sigma]", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "+=", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{
            RowBox[{"IdentityMatrix", "[", "3", "]"}], ",", 
            RowBox[{"calculateLocalM0", "[", "dots", "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Dx", ",", "Dy"}], "}"}], "=", 
          RowBox[{"calculateLocalD\[Alpha]", "[", "dots", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Ax", "=", 
          RowBox[{"getAx", "[", 
           RowBox[{
            RowBox[{"\[Rho]", "[", "dots", "]"}], ",", 
            RowBox[{"\[Mu]", "[", "dots", "]"}], ",", 
            RowBox[{"\[Lambda]", "[", "dots", "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Axv", "=", 
          RowBox[{"Ax", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1", ",", "2"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"3", ",", "4", ",", "5"}], "}"}]}], "]"}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"Ax\[Sigma]", "=", 
          RowBox[{"Ax", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"3", ",", "4", ",", "5"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"Ay", "=", 
          RowBox[{"getAy", "[", 
           RowBox[{
            RowBox[{"\[Rho]", "[", "dots", "]"}], ",", 
            RowBox[{"\[Mu]", "[", "dots", "]"}], ",", 
            RowBox[{"\[Lambda]", "[", "dots", "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Ayv", "=", 
          RowBox[{"Ay", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1", ",", "2"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"3", ",", "4", ",", "5"}], "}"}]}], "]"}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"Ay\[Sigma]", "=", 
          RowBox[{"Ay", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"3", ",", "4", ",", "5"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Bv", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "-=", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"Axv", ",", "Dx"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Bv", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "-=", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"Ayv", ",", "Dy"}], "]"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"B\[Sigma]", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "-=", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"Ax\[Sigma]", ",", "Dx"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"B\[Sigma]", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "-=", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"Ay\[Sigma]", ",", "Dy"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", "1"}], ",", 
           RowBox[{"j", "\[LessEqual]", "3"}], ",", 
           RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"nj", "=", 
             RowBox[{"getNormalVectorOfJthSide", "[", 
              RowBox[{"dots", ",", "j"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"Anv", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"nj", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "*", "Axv"}], "+", 
              RowBox[{
               RowBox[{"nj", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "*", "Ayv"}]}]}], ";", 
            "\[IndentingNewLine]", 
