Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"IMPLEMENTATION", " ", "WITH", " ", "GLOBAL", " ", "MATRICIES"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"precomputeInvM0", "[", 
     RowBox[{"nodes_", ",", "elements_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"i", ",", "dots", ",", "res"}], "}"}], ",", 
      RowBox[{"(", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"res", "=", 
         RowBox[{"Table", "[", 
          RowBox[{"0", ",", 
           RowBox[{"Length", "[", "elements", "]"}], ",", "3", ",", "3"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
          RowBox[{"i", "\[LessEqual]", 
           RowBox[{"Length", "[", "elements", "]"}]}], ",", 
          RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"dots", "=", 
            RowBox[{"nodes", "[", 
             RowBox[{"[", 
              RowBox[{"elements", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"res", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "=", 
            RowBox[{"Inverse", "[", 
             RowBox[{"calculateLocalM0", "[", "dots", "]"}], "]"}]}], ";"}]}],
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "res"}], 
       "\[IndentingNewLine]", ")"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"precomputeAxAy", "[", 
     RowBox[{
     "\[Rho]_", ",", "\[Mu]_", ",", "\[Lambda]_", ",", "nodes_", ",", 
      "elements_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Ax", ",", "Ay", ",", "dots", ",", "i"}], "}"}], ",", 
      RowBox[{"(", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Ax", "=", 
         RowBox[{"Table", "[", 
          RowBox[{"0", ",", 
           RowBox[{"Length", "[", "elements", "]"}], ",", "3", ",", "3"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
          RowBox[{"i", "\[LessEqual]", 
           RowBox[{"Length", "[", "elements", "]"}]}], ",", 
          RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"dots", "=", 
            RowBox[{"nodes", "[", 
             RowBox[{"[", 
              RowBox[{"elements", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Ax", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "=", 
            RowBox[{"getAx", "[", 
             RowBox[{"\[Rho]", ",", "\[Mu]", ",", "\[Lambda]"}], "]"}]}], ";",
            "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Ay", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "=", 
            RowBox[{"getAy", "[", 
             RowBox[{"\[Rho]", ",", "\[Mu]", ",", "\[Lambda]"}], "]"}]}], 
           ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"Ax", ",", "Ay"}], "}"}]}], "\[IndentingNewLine]", ")"}]}], 
     "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"precomputeAn", "[", 
     RowBox[{
     "\[Rho]_", ",", "\[Mu]_", ",", "\[Lambda]_", ",", "nodes_", ",", 
      "elements_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"An", ",", "i", ",", "j", ",", "coords", ",", "n"}], "}"}], 
      ",", 
      RowBox[{"(", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "per", " ", "element", " ", "per", " ", "edge", " ", "we", " ", 
         "have", " ", "An"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"An", "=", 
         RowBox[{"Table", "[", 
          RowBox[{"0", ",", 
           RowBox[{"Length", "[", "elements", "]"}], ",", "3", ",", "3", ",", 
           "3"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
          RowBox[{"i", "\[LessEqual]", 
           RowBox[{"Length", "[", "elements", "]"}]}], ",", 
          RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"dots", "=", 
            RowBox[{"nodes", "[", 
             RowBox[{"[", 
              RowBox[{"elements", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"j", "=", "1"}], ",", 
             RowBox[{"j", "\[LessEqual]", "3"}], ",", 
             RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"n", "=", 
               RowBox[{"getNormalVectorOfJthSide", "[", 
                RowBox[{"dots", ",", "j"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"An", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
               RowBox[{
                RowBox[{
                 RowBox[{"n", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "*", 
                 RowBox[{"getAx", "[", 
                  RowBox[{"\[Rho]", ",", "\[Mu]", ",", "\[Lambda]"}], "]"}]}],
                 "+", 
                RowBox[{
                 RowBox[{"getAy", "[", 
                  RowBox[{"\[Rho]", ",", "\[Mu]", ",", "\[Lambda]"}], "]"}], 
                 "*", 
                 RowBox[{"n", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}]}]}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
         "]"}], ";"}], "\[IndentingNewLine]", ")"}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"assembleGlobalMatricies", "[", 
     RowBox[{"elements_", ",", " ", "nodes_", ",", " ", "neighbours_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "R", ",", "Mx", ",", "My", ",", "M0", ",", "degreesOfFreedom", ",", 
        "numberOfElements", ",", "ind", ",", "indk", ",", "dots", ",", "k", 
        ",", "locR"}], "}"}], ",", 
      RowBox[{"(", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
        "Print", "[", 
         "\"\<Function is not up to date with helper functions\>\"", "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", 
         RowBox[{"-", "1"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"numberOfElements", "=", 
         RowBox[{"Length", "[", "elements", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"degreesOfFreedom", "=", "3"}], ";", "\[IndentingNewLine]", 
        RowBox[{"M0", "=", 
         RowBox[{"Table", "[", 
          RowBox[{"0", ",", 
           RowBox[{"degreesOfFreedom", "*", "numberOfElements"}], ",", 
           RowBox[{"degreesOfFreedom", "*", "numberOfElements"}]}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
