  3.952515845181415*^9}, {3.9525160531546216`*^9, 3.952516077325499*^9}, {
  3.952861946214061*^9, 3.9528619729956913`*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"422826ce-e071-4dee-a19c-a87f056187ad"],

