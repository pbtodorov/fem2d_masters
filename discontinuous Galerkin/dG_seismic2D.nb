3c798d28d23f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"getShortestEdgeInMesh", "[", 
   RowBox[{"nodes_", ",", "elements_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "maxLen", ",", "temp", ",", "i", ",", "j", ",", "allNodes", ",", 
      "maxi"}], "}"}], ",", 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"maxLen", "=", "10"}], ";", "\[IndentingNewLine]", 
      RowBox[{"maxi", "=", 
       RowBox[{"-", "1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", " ", "=", "n"}], ",", 
        RowBox[{"i", ">", "0"}], ",", 
        RowBox[{"i", "--"}], ",", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"j", "=", "1"}], ",", 
          RowBox[{"j", "\[LessEqual]", "3"}], ",", 
          RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"allNodes", "=", 
            RowBox[{"{", 
             RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"allNodes", "=", 
            RowBox[{"DeleteCases", "[", 
             RowBox[{"allNodes", ",", "j"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"temp", "=", 
            RowBox[{"EuclideanDistance", "[", 
             RowBox[{
              RowBox[{"nodes", "[", 
               RowBox[{"[", 
                RowBox[{"elements", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", 
                   RowBox[{"allNodes", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "]"}], "]"}], 
               "]"}], ",", 
              RowBox[{"nodes", "[", 
               RowBox[{"[", 
                RowBox[{"elements", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", 
                   RowBox[{"allNodes", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "]"}], 
               "]"}]}], "]"}]}], ";", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"temp", "<", "maxLen"}], ",", 
             RowBox[{
              RowBox[{"maxLen", "=", "temp"}], ";", 
              RowBox[{"maxi", "=", 
               RowBox[{"{", 
                RowBox[{"i", ",", "j"}], "}"}]}]}]}], "]"}]}]}], 
         "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", "maxLen"}], "\[IndentingNewLine]", ")"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9525152093324003`*^9, 3.9525152935873537`*^9}, {
  3.952515397713437*^9, 3.9525154989039516`*^9}, {3.9525155422261686`*^9, 
  3.952515551885462*^9}, {3.9525155869499483`*^9, 3.952515608603983*^9}, {
