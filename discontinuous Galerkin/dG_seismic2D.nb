Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Rho]", "[", "dots_", "]"}], ":=", "1."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Mu]", "[", "dots_", "]"}], ":=", "1."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]", "[", "dots_", "]"}], ":=", "1."}]}], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"11d42117-b771-4302-97c1-37519d40e663"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Utils", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Generates", " ", "a", " ", "map", " ", "with", " ", "key", " ", "the", 
     " ", "index", " ", "of", " ", "an", " ", "element", " ", "in", " ", "a", 
     " ", "triangle", " ", "mesh", " ", "and", " ", "value", " ", "array", 
     " ", "of", " ", "indices", " ", "of", " ", "neighbouring", " ", 
     "elements", " ", "ordered", " ", "by", " ", "their", " ", "edge", " ", 
     "numbers"}], "\[IndentingNewLine]", "-", 
    RowBox[{
    "1", " ", "if", " ", "there", " ", "is", " ", "no", " ", "neighbour", " ",
      "for", " ", "corresponding", " ", "edge"}]}], "\[IndentingNewLine]", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"tri2Tri", "[", 
     RowBox[{"nodes_", ",", "elements_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "nt", ",", "np", ",", "neighbours", ",", " ", "n2e", ",", "i", ",", 
        "elementsWithNode1", ",", " ", "elementsWithNode2", ",", " ", 
        "elementsWithNode3", ",", " ", "elementsWithEdge1", ",", " ", 
        "elementsWithEdge2", ",", " ", "elementsWithEdge3"}], " ", "}"}], ",", 
      RowBox[{"(", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"nt", "=", 
         RowBox[{"Length", "[", "elements", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"np", "=", 
         RowBox[{"Length", "[", "nodes", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"neighbours", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "nt", ",", "3"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"n2e", "=", 
         RowBox[{"GroupBy", "[", 
          RowBox[{
