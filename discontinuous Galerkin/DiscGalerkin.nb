Notebook[{

Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"region", "=", 
   RowBox[{"Rectangle", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<NDSolve`FEM`\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "=", "0.0001"}], ";"}], " ", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Generate", " ", "triangular", " ", "mesh"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"em", "=", 
    RowBox[{"ToElementMesh", "[", 
     RowBox[{"region", ",", 
      RowBox[{"\"\<MeshOrder\>\"", "\[Rule]", "1"}], ",", 
      RowBox[{
      "\"\<MeshElementType\>\"", "\[Rule]", "\"\<TriangleElement\>\""}], ",", 
      RowBox[{"MaxCellMeasure", "\[Rule]", "h"}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Extract", " ", "mesh", " ", "elements", " ", "and", " ", "nodes"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"elements", "=", 
   RowBox[{
    RowBox[{"em", "[", "\"\<MeshElements\>\"", "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nodes", "=", 
    RowBox[{"em", "[", "\"\<Coordinates\>\"", "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Compute", " ", "triangle", " ", "centroids", " ", "for", " ", 
    "labeling"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"centroids", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Mean", "[", 
        RowBox[{"nodes", "[", 
         RowBox[{"[", "#", "]"}], "]"}], "]"}], "&"}], "/@", "elements"}]}], 
    ";"}], "*)"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Create", " ", "text", " ", "labels", " ", "for", " ", "each", " ", 
    "triangle"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"labels", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"#1", ",", "12", ",", "Blue"}], "]"}], ",", "#2"}], "]"}], 
        "&"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "elements", "]"}], "]"}], ",", "centroids"}],
         "}"}]}], "]"}]}], ";"}], "*)"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Show", " ", "mesh", " ", "with", " ", "labeled", " ", "triangle", " ", 
    "indices"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"em", "[", "\"\<Wireframe\>\"", "]"}], 
  RowBox[{"(*", 
   RowBox[{",", 
    RowBox[{"Graphics", "[", "labels", "]"}]}], "*)"}], "]"}], "\n"}], "Input",
