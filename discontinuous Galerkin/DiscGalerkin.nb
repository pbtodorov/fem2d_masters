Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"areaGradHelper", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"area", ",", "b", ",", "c"}], "}"}], ",", 
     RowBox[{"(", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"area", ",", "b", ",", "c"}], "}"}], "\[IndentingNewLine]", 
      ")"}]}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dG1CellAssembler2D", "[", 
   RowBox[{"elements_", ",", " ", "nodes_", ",", " ", "force_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "nt", ",", "A", ",", "b", ",", "coordinates", ",", "x", ",", "y", ",", 
      "dofs", ",", "area", ",", "c", ",", "MK", ",", "bK", ",", "bb"}], "}"}],
     ",", 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"nt", " ", "=", " ", 
       RowBox[{"Length", "[", "elements", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"A", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"3", "*", "nt"}], ",", 
         RowBox[{"3", "*", "nt"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"bb", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"3", "*", "nt"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<=", "nt"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"coordinates", "=", 
          RowBox[{"Transpose", "[", 
           RowBox[{"nodes", "[", 
            RowBox[{"[", 
             RowBox[{"elements", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"x", " ", "=", " ", 
          RowBox[{"coordinates", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"y", "=", 
          RowBox[{"coordinates", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"dofs", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"3", "*", "i"}], "-", "2"}], ",", 
            RowBox[{
             RowBox[{"3", "*", "i"}], "-", "1"}], ",", 
            RowBox[{"3", "*", "i"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"TO", " ", 
           RowBox[{"DO", ":", " ", 
            RowBox[{
             RowBox[{"Move", " ", "into", " ", "separate", " ", "function"}], 
             "-", " ", 
             RowBox[{"perf", " ", "test", " ", "first"}]}]}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"area", "=", 
          RowBox[{"0.5", "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"x", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "*", 
              RowBox[{"y", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "+", 
             RowBox[{
              RowBox[{"x", "[", 
               RowBox[{"[", "3", "]"}], "]"}], "*", 
              RowBox[{"y", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], "+", 
             RowBox[{
              RowBox[{"x", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "*", 
              RowBox[{"y", "[", 
               RowBox[{"[", "3", "]"}], "]"}]}], "-", 
             RowBox[{
              RowBox[{"x", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "*", 
              RowBox[{"y", "[", 
               RowBox[{"[", "3", "]"}], "]"}]}], "-", 
             RowBox[{
              RowBox[{"y", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "*", 
              RowBox[{"x", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "-", 
             RowBox[{
              RowBox[{"y", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "*", 
              RowBox[{"x", "[", 
               RowBox[{"[", "3", "]"}], "]"}]}]}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"b", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"y", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "-", 
                RowBox[{"y", "[", 
                 RowBox[{"[", "3", "]"}], "]"}]}], ",", 
               RowBox[{
                RowBox[{"y", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], "-", 
                RowBox[{"y", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], ",", 
               RowBox[{
                RowBox[{"y", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "-", 
                RowBox[{"y", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], "}"}], "/", "2"}],
            "/", "area"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"c", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"x", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], "-", 
                RowBox[{"x", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], ",", 
               RowBox[{
                RowBox[{"x", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "-", 
                RowBox[{"x", "[", 
                 RowBox[{"[", "3", "]"}], "]"}]}], ",", 
               RowBox[{
                RowBox[{"x", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "-", 
                RowBox[{"x", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], "}"}], "/", "2"}],
            "/", "area"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"MK", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Transpose", "[", "b", "]"}], ".", "b"}], " ", "+", " ", 
