Cell[BoxData[
 RowBox[{
  RowBox[{"dG1EdgeAssembler2D", "[", 
   RowBox[{
   "elements_", ",", " ", "nodes_", ",", "neighbours_", ",", " ", 
    "hatCoefficients_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "nt", ",", "np", ",", "P", ",", "S", ",", "edge2node", ",", "cmat", ",", 
      "wvec", ",", "dots", ",", "area", ",", "dx", ",", "dy", ",", "ds", ",", 
      "nx", ",", "ny", ",", "n", ",", "e2n", ",", "coordinatesForSimpson", 
      ",", "SE", ",", "PE", ",", "neighbourNodes", ",", "q", " ", ",", "i", 
      ",", "j", ",", "ai", ",", "bi", ",", "ci", ",", "an", ",", "bn", ",", 
      "cn", ",", "\[Phi]i", ",", "\[Phi]n", ",", "wxlen", ",", "jump", ",", 
      "avgdn", ",", "dofs"}], "}"}], ",", 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"nt", "=", 
       RowBox[{"Length", "[", "elements", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"np", "=", 
       RowBox[{"Length", "[", "nodes", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"P", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"3", "*", "nt"}], ",", 
         RowBox[{"3", "*", "nt"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"S", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"3", "*", "nt"}], ",", 
         RowBox[{"3", "*", "nt"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"i", "-", 
        RowBox[{
        "th", " ", "element", " ", "gives", " ", "us", " ", "the", " ", 
         "nodes", " ", "of", " ", "the", " ", "i"}], "-", 
        RowBox[{"th", " ", "edge"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"edge2node", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", "3"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "3"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "coefficients", " ", "for", " ", "Simpson", " ", "integration"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"cmat", "=", 
       RowBox[{"0.5", "*", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"2", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "2"}], "}"}]}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"wvec", "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1.", ",", "4.", ",", "1."}], "}"}], "/", "6."}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "\[LessEqual]", "nt"}], ",", 
        RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dots", "=", 
          RowBox[{"nodes", "[", 
           RowBox[{"[", 
            RowBox[{"elements", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"area", "=", 
          RowBox[{"0.5", "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"dots", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
              RowBox[{"dots", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "+", 
             RowBox[{
              RowBox[{"dots", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "2"}], "]"}], "]"}], "*", 
              RowBox[{"dots", "[", 
               RowBox[{"[", 
                RowBox[{"3", ",", "1"}], "]"}], "]"}]}], "+", 
             RowBox[{
              RowBox[{"dots", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", "1"}], "]"}], "]"}], "*", 
              RowBox[{"dots", "[", 
               RowBox[{"[", 
                RowBox[{"3", ",", "2"}], "]"}], "]"}]}], "-", 
             RowBox[{
              RowBox[{"dots", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", 
              RowBox[{"dots", "[", 
               RowBox[{"[", 
                RowBox[{"3", ",", "2"}], "]"}], "]"}]}], "-", 
             RowBox[{
              RowBox[{"dots", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "2"}], "]"}], "]"}], "*", 
              RowBox[{"dots", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", "1"}], "]"}], "]"}]}], "-", 
             RowBox[{
              RowBox[{"dots", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", "2"}], "]"}], "]"}], "*", 
              RowBox[{"dots", "[", 
               RowBox[{"[", 
                RowBox[{"3", ",", "1"}], "]"}], "]"}]}]}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"dx", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"dots", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", "1"}], "]"}], "]"}], "-", 
             RowBox[{"dots", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"dots", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], "-", 
             RowBox[{"dots", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", "1"}], "]"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"dots", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "1"}], "]"}], "]"}], "-", 
             RowBox[{"dots", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}]}]}], "}"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"dy", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"dots", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", "2"}], "]"}], "]"}], "-", 
             RowBox[{"dots", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"dots", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "2"}], "]"}], "]"}], "-", 
             RowBox[{"dots", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", "2"}], "]"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"dots", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "2"}], "]"}], "]"}], "-", 
             RowBox[{"dots", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "2"}], "]"}], "]"}]}]}], "}"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"ds", "=", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"dx", "*", "dx"}], "+", 
            RowBox[{"dy", "*", "dy"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"nx", "=", 
          RowBox[{
           RowBox[{"-", "dy"}], "/", "ds"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"ny", "=", 
          RowBox[{"dx", "/", "ds"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", "1"}], ",", 
           RowBox[{"j", "\[LessEqual]", "3"}], ",", 
           RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Kn", 
             RowBox[{"(", 
              RowBox[{"K", "-"}], ")"}], " ", "and", " ", "Ki", 
             RowBox[{"(", 
              RowBox[{"K", "+"}], ")"}], " ", "are", " ", "neighbours"}], 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"n", "=", 
             RowBox[{"neighbours", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"n", ">", "i"}], ",", 
              RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"n", "<", "0"}], ",", 
              RowBox[{"n", "=", "i"}]}], "]"}], ";", 
            RowBox[{"(*", "\[Delta]\[CapitalOmega]", "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{"e2n", "=", 
             RowBox[{"edge2node", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], ";", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{
              "numbers", " ", "of", " ", "nodes", " ", "on", " ", "j"}], "-", 
              RowBox[{"th", " ", "edge"}]}], "*)"}], "\[IndentingNewLine]", 
            RowBox[{"coordinatesForSimpson", "=", 
             RowBox[{"cmat", ".", 
              RowBox[{"dots", "[", 
               RowBox[{"[", "e2n", "]"}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"SE", "=", 
             RowBox[{"Table", "[", 
              RowBox[{"0", ",", "6", ",", "6"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"PE", "=", 
             RowBox[{"Table", "[", 
              RowBox[{"0", ",", "6", ",", "6"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"neighbourNodes", "=", 
             RowBox[{"nodes", "[", 
              RowBox[{"[", 
               RowBox[{"elements", "[", 
                RowBox[{"[", "n", "]"}], "]"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"For", "[", 
             RowBox[{
              RowBox[{"q", "=", "1"}], ",", 
              RowBox[{"q", "\[LessEqual]", "3"}], ",", 
              RowBox[{"q", "++"}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"ai", "=", 
                RowBox[{
                 RowBox[{"hatCoefficients", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"bi", "=", 
                RowBox[{
                 RowBox[{"hatCoefficients", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"ci", "=", 
                RowBox[{
                 RowBox[{"hatCoefficients", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "[", 
                 RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"an", "=", 
                RowBox[{
                 RowBox[{"hatCoefficients", "[", 
                  RowBox[{"[", "n", "]"}], "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"bn", "=", 
                RowBox[{
                 RowBox[{"hatCoefficients", "[", 
                  RowBox[{"[", "n", "]"}], "]"}], "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"cn", "=", 
                RowBox[{
                 RowBox[{"hatCoefficients", "[", 
                  RowBox[{"[", "n", "]"}], "]"}], "[", 
                 RowBox[{"[", "3", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"\[Phi]i", "=", 
                RowBox[{"ai", "+", 
                 RowBox[{"bi", "*", 
                  RowBox[{"coordinatesForSimpson", "[", 
                   RowBox[{"[", 
                    RowBox[{"q", ",", "1"}], "]"}], "]"}]}], "+", 
                 RowBox[{"ci", "*", 
                  RowBox[{"coordinatesForSimpson", "[", 
                   RowBox[{"[", 
                    RowBox[{"q", ",", "2"}], "]"}], "]"}]}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"\[Phi]n", "=", 
                RowBox[{"an", "+", 
                 RowBox[{"bn", "*", 
                  RowBox[{"coordinatesForSimpson", "[", 
                   RowBox[{"[", 
                    RowBox[{"q", ",", "1"}], "]"}], "]"}]}], "+", 
                 RowBox[{"cn", "*", 
                  RowBox[{"coordinatesForSimpson", "[", 
                   RowBox[{"[", 
                    RowBox[{"q", ",", "2"}], "]"}], "]"}]}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"wxlen", "=", 
                RowBox[{
                 RowBox[{"wvec", "[", 
                  RowBox[{"[", "q", "]"}], "]"}], "*", 
                 RowBox[{"ds", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"jump", "=", 
                RowBox[{"{", 
                 RowBox[{"Join", "[", 
                  RowBox[{"\[Phi]i", ",", 
                   RowBox[{"-", "\[Phi]n"}]}], "]"}], "}"}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"avgdn", "=", 
                RowBox[{"0.5", "*", 
                 RowBox[{"{", 
                  RowBox[{"Join", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"nx", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "*", "bi"}], "+", 
                    RowBox[{
                    RowBox[{"ny", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "*", "ci"}]}], ",", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"nx", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "*", "bn"}], "+", 
                    RowBox[{
                    RowBox[{"ny", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "*", "cn"}]}]}], "]"}], 
                  "}"}]}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"PE", "+=", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Transpose", "[", "jump", "]"}], ".", "jump"}], "*",
                  "wxlen"}]}], ";", "\[IndentingNewLine]", 
               RowBox[{"SE", "+=", 
                RowBox[{
