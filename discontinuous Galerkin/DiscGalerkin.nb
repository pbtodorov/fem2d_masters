Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Utils", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"getHatCoefficients", "[", "dots_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"A", ",", "V"}], "}"}], ",", 
      RowBox[{"(", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"V", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"j", ">", "1"}], ",", 
             RowBox[{"dots", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", 
                RowBox[{"j", "-", "1"}]}], "]"}], "]"}], " ", ",", "1"}], 
            "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", "3"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "3"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"A", "=", 
         RowBox[{"Inverse", "[", "V", "]"}]}], ";", "\[IndentingNewLine]", 
        "A"}], "\[IndentingNewLine]", ")"}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"precomputeHatCoefficients", "[", 
     RowBox[{"nodes_", ",", "elements_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"A", ",", "V", ",", "dots", ",", "nt", ",", "i"}], "}"}], ",", 
      RowBox[{"(", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"nt", "=", 
         RowBox[{"Length", "[", "elements", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"A", "=", 
         RowBox[{"Table", "[", 
          RowBox[{"0", ",", "nt", ",", "3", ",", "3"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
          RowBox[{"i", "\[LessEqual]", "nt"}], ",", 
          RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"dots", "=", 
            RowBox[{"nodes", "[", 
             RowBox[{"[", 
              RowBox[{"elements", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"A", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "=", 
            RowBox[{"getHatCoefficients", "[", "dots", "]"}]}]}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", "A"}], 
       "\[IndentingNewLine]", ")"}]}], "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Finds", " ", "neighbouring", " ", "elements", " ", "in", " ", "a", " ", 
     "triangle", " ", "mesh"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tri2Tri", "[", 
     RowBox[{"nodes_", ",", "elements_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "nt", ",", "np", ",", "neighbours", ",", " ", "n2e", ",", "i", ",", 
        "elementsWithNode1", ",", " ", "elementsWithNode2", ",", " ", 
        "elementsWithNode3", ",", " ", "elementsWithEdge1", ",", " ", 
        "elementsWithEdge2", ",", " ", "elementsWithEdge3"}], " ", "}"}], ",", 
      RowBox[{"(", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"nt", "=", 
         RowBox[{"Length", "[", "elements", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"np", "=", 
         RowBox[{"Length", "[", "nodes", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"neighbours", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "nt", ",", "3"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"n2e", "=", 
         RowBox[{"GroupBy", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{"MapIndexed", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"#1", "\[Rule]", 
                 RowBox[{"First", "[", "#2", "]"}]}], "&"}], ",", "elements", 
               ",", 
               RowBox[{"{", "2", "}"}]}], "]"}], ",", "1"}], "]"}], ",", 
           RowBox[{"First", "\[Rule]", "Last"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "1"}], ",", 
          RowBox[{"i", "<=", "nt"}], ",", 
          RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"elementsWithNode1", "=", 
            RowBox[{"Lookup", "[", 
             RowBox[{"n2e", ",", 
              RowBox[{"elements", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{"{", "}"}]}], "]"}]}], ";", 
           RowBox[{"elementsWithNode2", "=", 
            RowBox[{"Lookup", "[", 
             RowBox[{"n2e", ",", 
              RowBox[{"elements", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"elementsWithNode3", "=", 
            RowBox[{"Lookup", "[", 
             RowBox[{"n2e", ",", 
              RowBox[{"elements", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "3"}], "]"}], "]"}], ",", 
              RowBox[{"{", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"elementsWithEdge1", " ", "=", " ", 
            RowBox[{"DeleteCases", "[", 
             RowBox[{
              RowBox[{"Intersection", "[", 
               RowBox[{"elementsWithNode2", ",", " ", "elementsWithNode3"}], 
               "]"}], ",", "i"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"elementsWithEdge1", " ", "\[NotEqual]", " ", 
              RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"neighbours", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "1"}], "]"}], "]"}], "=", 
              RowBox[{"elementsWithEdge1", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}]}], "\[IndentingNewLine]", 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"elementsWithEdge2", "=", 
            RowBox[{"DeleteCases", "[", 
             RowBox[{
              RowBox[{"Intersection", "[", 
               RowBox[{"elementsWithNode1", ",", "elementsWithNode3"}], "]"}],
               ",", "i"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"elementsWithEdge2", " ", "\[NotEqual]", " ", 
              RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"neighbours", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "2"}], "]"}], "]"}], "=", 
              RowBox[{"elementsWithEdge2", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}]}], "\[IndentingNewLine]", 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"elementsWithEdge3", "=", 
            RowBox[{"DeleteCases", "[", 
             RowBox[{
              RowBox[{"Intersection", "[", 
               RowBox[{"elementsWithNode1", ",", "elementsWithNode2"}], "]"}],
               ",", "i"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"elementsWithEdge3", " ", "\[NotEqual]", " ", 
              RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"neighbours", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "3"}], "]"}], "]"}], "=", 
              RowBox[{"elementsWithEdge3", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}]}], "\[IndentingNewLine]", 
            "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", "neighbours"}], "\[IndentingNewLine]", ")"}]}],
      "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.948033292867655*^9, 3.948033318050428*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"be843458-2855-4dfa-90e9-9ab4e557c5d9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Global", " ", "variables"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nt", "=", 
     RowBox[{"Length", "[", "elements", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"np", "=", 
     RowBox[{"Length", "[", "nodes", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"neighbours", " ", "=", " ", 
     RowBox[{"tri2Tri", "[", 
      RowBox[{"nodes", ",", "elements"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hatCoefficients", "=", 
     RowBox[{"precomputeHatCoefficients", "[", 
      RowBox[{"nodes", ",", "elements"}], "]"}]}], ";", 
    RowBox[{
     RowBox[{"force", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{"2", "*", 
      RowBox[{"Pi", "^", "2"}], "*", 
      RowBox[{"Sin", "[", 
       RowBox[{"Pi", "*", "x"}], "]"}], "*", 
      RowBox[{"Sin", "[", 
       RowBox[{"Pi", "*", "y"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
