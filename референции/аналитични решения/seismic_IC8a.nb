            RowBox[{"x", ",", "y", ",", 
             RowBox[{"dataFunction", "[", 
              RowBox[{"x", ",", "y"}], "]"}]}], "}"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"First", "@", "dataRanges"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", 
            RowBox[{"Last", "@", "dataRanges"}]}], "}"}]}], "]"}], ",", "1"}],
        "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"filenum", "=", 
      RowBox[{"IntegerString", "[", "i", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"filename", "=", 
      RowBox[{"StringJoin", "[", 
       RowBox[{
       "\"\<Y:\\\\seismic\\\\sm200612fig1\\\\test\>\"", ",", "filenum", ",", 
        "\"\<.dat\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", "filename", "]"}], ";", "\[IndentingNewLine]", 
