Cell[BoxData[
 RowBox[{
  RowBox[{"initial", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ux", ",", "uy"}], "}"}], ",", 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ux", "=", 
       RowBox[{
        RowBox[{"-", "2"}], "*", 
        RowBox[{"x", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"x", "^", "2"}], "+", "1"}], ")"}], "^", "2"}], "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"y", "^", "2"}], "+", "1"}], ")"}]}], ")"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"uy", "=", 
       RowBox[{
        RowBox[{"-", "2"}], "*", 
        RowBox[{"y", "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"y", "^", "2"}], "+", "1"}], ")"}], "^", "2"}], "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"x", "^", "2"}], "+", "1"}], ")"}]}], ")"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ux", "^", "2"}], "+", 
       RowBox[{"uy", "^", "2"}]}]}], "\[IndentingNewLine]", ")"}]}], 
   "]"}]}]], "Input",
