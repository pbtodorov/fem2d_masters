 RowBox[{
  RowBox[{"x1", "=", "8"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ParallelDo", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"dataFunction", "[", 
       RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"Re", "[", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"ux", "/.", 
             RowBox[{"a", "\[Rule]", "i"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"m", ",", 
              RowBox[{"-", "1"}], ",", "1", ",", "2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"n", ",", 
              RowBox[{"-", "1"}], ",", "1", ",", "2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"p", ",", 
              RowBox[{"-", "1"}], ",", "1", ",", "2"}], "}"}]}], "]"}], "]"}],
          "2"], "+", 
        SuperscriptBox[
         RowBox[{"Re", "[", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"uy", "/.", 
             RowBox[{"a", "\[Rule]", "i"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"m", ",", 
              RowBox[{"-", "1"}], ",", "1", ",", "2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"n", ",", 
              RowBox[{"-", "1"}], ",", "1", ",", "2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"p", ",", 
              RowBox[{"-", "1"}], ",", "1", ",", "2"}], "}"}]}], "]"}], "]"}],
          "2"]}], "]"}]}], ";", "\n", 
     RowBox[{"dataRanges", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "x1"}], "+", ".025"}], ",", 
          RowBox[{"x1", "-", ".025"}], ",", "0.1"}], "]"}], ",", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "x1"}], ",", "x1", ",", "0.1"}], "]"}]}], "}"}]}], ";",
      "\n", 
     RowBox[{"data", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"1.", " ", 
