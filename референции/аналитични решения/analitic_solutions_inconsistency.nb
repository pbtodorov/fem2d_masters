Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Using", " ", "the", " ", "closed", " ", "formula"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{
    "m_", ",", "n_", ",", "p_", ",", "\[Beta]_", ",", "t_", ",", "x_", ",", 
     "y_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "r", "}"}], ",", 
     RowBox[{"(", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"s", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", "7"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"d", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", "3"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"r", "=", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"x", "^", "2"}], "+", 
          RowBox[{"y", "^", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"d", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "=", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"r", "^", "2"}], "-", 
          RowBox[{
           RowBox[{"\[Beta]", "^", "2"}], 
           RowBox[{"t", "^", "2"}]}], "-", "2", "-", 
          RowBox[{"2", "I", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"m", "*", "x"}], "+", 
             RowBox[{"p", "*", "y"}]}], ")"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"d", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{"n", "*", "\[Beta]", "*", "t"}], "+", 
         RowBox[{"m", "*", "x"}], "-", "I"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"d", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{"n", "*", "\[Beta]", "*", "t"}], "+", 
         RowBox[{"p", "*", "y"}], "-", "I"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"s", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "=", 
        RowBox[{"m", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"3", "I", "*", "n", "*", "\[Beta]", "*", "t", "*", 
            RowBox[{"(", 
             RowBox[{"2", "-", 
              RowBox[{
               RowBox[{"\[Beta]", "^", "2"}], 
               RowBox[{"t", "^", "2"}]}]}], ")"}]}], "+", 
           RowBox[{"2", 
            RowBox[{"\[Beta]", "^", "4"}], 
            RowBox[{"t", "^", "4"}]}], "-", 
           RowBox[{"3", 
            RowBox[{"\[Beta]", "^", "2"}], 
            RowBox[{"t", "^", "2"}]}], "+", 
           RowBox[{"r", "^", "4"}], "-", 
           RowBox[{"8", 
            RowBox[{"r", "^", "2"}]}], "+", "4"}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"s", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "=", 
        RowBox[{"n", "*", 
         RowBox[{"\[Beta]", "^", "3"}], "*", 
         RowBox[{"t", "^", "3"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"4", "x"}], "-", 
           RowBox[{"m", "*", "p", "*", "y"}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"s", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "=", 
        RowBox[{"3", 
         RowBox[{"\[Beta]", "^", "2"}], 
         RowBox[{"t", "^", "2"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"m", "*", 
            RowBox[{"x", "^", "2"}]}], "-", 
           RowBox[{"m", "*", 
            RowBox[{"y", "^", "2"}]}], "+", 
           RowBox[{"p", "*", "x", "*", "y"}], "+", 
           RowBox[{"I", "*", "m", "*", "p", "*", "y"}], "-", 
           RowBox[{"3", "I", "*", "x"}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"s", "[", 
         RowBox[{"[", "4", "]"}], "]"}], "=", 
        RowBox[{"n", "*", "\[Beta]", "*", "t", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", 
            RowBox[{"x", "^", "3"}]}], "-", 
           RowBox[{"x", "*", 
            RowBox[{"y", "^", "2"}]}], "-", 
           RowBox[{"13", "x"}], "+", 
           RowBox[{"m", "*", "p", "*", "y", "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"4", 
               RowBox[{"x", "^", "2"}]}], "+", 
              RowBox[{"y", "^", "2"}], "-", "5"}], ")"}]}], "-", 
           RowBox[{"2", "I", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"3", "p", "*", "x", "*", "y"}], "+", 
              RowBox[{"5", "m", "*", 
               RowBox[{"x", "^", "2"}]}], "+", 
              RowBox[{"m", "*", 
               RowBox[{"y", "^", "2"}]}]}], ")"}]}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"s", "[", 
         RowBox[{"[", "5", "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "8"}], "p", "*", "x", "*", "y"}], "-", 
         RowBox[{"4", "I", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"r", "^", "2"}], "-", "2"}], ")"}], 
          RowBox[{"(", 
           RowBox[{"x", "+", 
            RowBox[{"m", "*", "p", "*", "y"}]}], ")"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"s", "[", 
         RowBox[{"[", "6", "]"}], "]"}], "=", 
        RowBox[{"3", "n", "*", "\[Beta]", "*", "t", "*", 
         RowBox[{"(", 
          RowBox[{"x", "-", 
           RowBox[{"m", "*", "I"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"s", "[", 
         RowBox[{"[", "7", "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{"ArcTanh", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"I", "-", 
             RowBox[{"p", "*", "y"}]}], ")"}], "/", 
           RowBox[{"d", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "+", 
         RowBox[{"ArcTanh", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"n", "*", "\[Beta]", "*", "t"}], "-", 
             RowBox[{"m", "*", "x"}], "+", 
             RowBox[{"p", "*", "y"}]}], ")"}], "/", 
           RowBox[{"d", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"s", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "5"}], "}"}]}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"8", "*", 
            RowBox[{
             RowBox[{"d", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "^", "4"}], "*", 
            RowBox[{
             RowBox[{"d", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], "*", 
            RowBox[{"d", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], ")"}]}], "+", 
         RowBox[{
          RowBox[{"s", "[", 
           RowBox[{"[", "6", "]"}], "]"}], "*", 
          RowBox[{
           RowBox[{"s", "[", 
            RowBox[{"[", "7", "]"}], "]"}], "/", 
           RowBox[{"(", 
            RowBox[{"4", "*", 
             RowBox[{
              RowBox[{"d", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "^", "5"}]}], ")"}]}]}]}], 
        "]"}]}], "\[IndentingNewLine]", ")"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9453379666070747`*^9, 3.945337967986163*^9}, {
