Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "from", " ", "a", " ", "number", " ", "from", " ", "0", " ", "to", " ", 
    "7", " ", "generates", " ", "the", " ", "different", " ", "possibilities",
     " ", "of", " ", "the", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "1"}], "}"}], "^", "3"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"generateParams", "[", "inputParams_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ip", ",", "n", ",", "m", ",", "p"}], "}"}], ",", 
     RowBox[{"(", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ip", " ", "=", " ", "inputParams"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"ip", ",", "2"}], "]"}], "*", "2"}], "-", "1"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"ip", "=", 
        RowBox[{"Floor", "[", 
         RowBox[{"ip", "/", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"m", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Mod", "[", 
            RowBox[{"ip", ",", "2"}], "]"}], "*", "2"}], "-", "1"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"p", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Floor", "[", 
            RowBox[{"ip", "/", "2"}], "]"}], "*", "2"}], "-", "1"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"n", ",", "m", ",", "p"}], "}"}]}], "\[IndentingNewLine]", 
      ")"}]}], "]"}]}]}]], "Input",
