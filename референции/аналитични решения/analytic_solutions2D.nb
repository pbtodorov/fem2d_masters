Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"generateFunction", "[", 
   RowBox[{"t_", ",", "inputParams_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"ip", ",", "n", ",", "m", ",", "p", ",", "\[Beta]"}], "}"}], ",", 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ip", " ", "=", " ", "inputParams"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"n", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{"ip", ",", "2"}], "]"}], "*", "2"}], "-", "1"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"ip", "=", 
       RowBox[{"Floor", "[", 
        RowBox[{"ip", "/", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"m", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{"ip", ",", "2"}], "]"}], "*", "2"}], "-", "1"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"p", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Floor", "[", 
           RowBox[{"ip", "/", "2"}], "]"}], "*", "2"}], "-", "1"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"\[Beta]", "=", "3."}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Cos", "[", "\[Phi]", "]"}], "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"m", " ", "x", " ", 
              RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "+", 
             RowBox[{"p", " ", "y", " ", 
              RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "+", 
             RowBox[{"n", " ", "\[Beta]", " ", "t"}]}], ")"}], "^", "3"}], 
          "-", 
          RowBox[{"3", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Cos", "[", "\[Phi]", "]"}], "+", 
              RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ")"}], "^", "2"}], "*", 
           "m", " ", "x", " ", 
           RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "+", 
          RowBox[{"p", " ", "y", " ", 
           RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "+", 
          RowBox[{"n", " ", "\[Beta]", " ", "t"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", "*", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Cos", "[", "\[Phi]", "]"}], "+", 
                RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ")"}], "^", "2"}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"m", " ", 
                 RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "+", 
                RowBox[{"p", " ", "y", " ", 
                 RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "+", 
                RowBox[{"n", " ", "\[Beta]", " ", "t"}]}], ")"}], "^", 
              "2"}]}], ")"}], "^", "3"}]}], ")"}]}]}]}], 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"{", 
       RowBox[{"p", ",", "m", ",", "n"}], "}"}], "*)"}], 
     "\[IndentingNewLine]", ")"}]}], "]"}]}]], "Input",
