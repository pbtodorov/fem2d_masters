Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rickerFT", "[", 
   RowBox[{"s_", ",", "f0_"}], "]"}], ":=", 
  RowBox[{"2", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"2", "/", "E"}], "]"}], " ", 
   RowBox[{"Pi", "^", "2"}], " ", 
   RowBox[{
    RowBox[{"s", "^", "2"}], "/", 
    RowBox[{"f0", "^", "3"}]}], " ", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Pi", "^", "2"}]}], " ", 
     RowBox[{
      RowBox[{"s", "^", "2"}], "/", 
      RowBox[{"f0", "^", "2"}]}]}], "]"}]}]}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"rickerFT", "[", 
    RowBox[{"s", ",", "8"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"s", ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "]"}]}], "Input",
