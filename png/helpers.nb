Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ricker", "[", 
    RowBox[{"t_", ",", "f0_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "tshift"}], "}"}], ",", 
     RowBox[{"(", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tshift", "=", 
        RowBox[{"1", "/", "f0"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"a", "=", 
        RowBox[{"Pi", "*", "f0", "*", 
         RowBox[{"(", 
          RowBox[{"t", "-", "tshift"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"2", "*", 
           RowBox[{"a", "^", "2"}]}]}], ")"}], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{"-", 
          RowBox[{"a", "^", "2"}]}], "]"}]}]}], "\[IndentingNewLine]", 
      ")"}]}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"2", "*", 
         RowBox[{"Pi", "^", "2"}], "*", "64", "*", 
         RowBox[{"t", "^", "2"}]}]}], ")"}], "*", 
      RowBox[{"E", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Pi", "^", "2"}]}], "*", "64", "*", 
         RowBox[{"t", "^", "2"}]}], ")"}]}]}], ",", 
     RowBox[{"ricker", "[", 
      RowBox[{"t", ",", "8"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{"-", "0.15"}], ",", "0.3"}], "}"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", " ", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
   RowBox[{"PlotLegends", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<r(t)\>\"", ",", "\"\<r(t-\!\(\*FractionBox[\(1\), \(f0\)]\))\>\""}],
      "}"}]}]}], "]"}]}], "Input",
