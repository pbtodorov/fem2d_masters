Cell[BoxData[
 RowBox[{
  RowBox[{"Ihat", "[", 
   RowBox[{"p_", ",", " ", "t_", ",", " ", "i_", ",", "x_"}], "]"}], " ", ":=",
   " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"res", ",", "r", ",", "a", ",", "b", ",", "c"}], "}"}], ",", 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"res", "=", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"j", "=", "1"}], ",", 
        RowBox[{"j", "\[LessEqual]", 
         RowBox[{"Length", "[", "t", "]"}]}], ",", 
        RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"RegionMember", "[", 
             RowBox[{
              RowBox[{"Triangle", "[", 
               RowBox[{"p", "[", 
                RowBox[{"[", 
                 RowBox[{"t", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "]"}], "]"}], "]"}], ",", 
              "x"}], "]"}], "&&", " ", 
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"t", "[", 
               RowBox[{"[", "j", "]"}], "]"}], ",", "i"}], "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"r", "=", 
             RowBox[{
              RowBox[{"Position", "[", 
               RowBox[{
                RowBox[{"t", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], ",", "i"}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"a", ",", "b", ",", "c"}], "}"}], "=", 
             RowBox[{"LinearSolve", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Insert", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"p", "[", 
                    RowBox[{"[", 
                    RowBox[{"t", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "]"}], "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", "1", ",", "3"}], 
                  "]"}], ",", 
                 RowBox[{"Insert", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"p", "[", 
                    RowBox[{"[", 
                    RowBox[{"t", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "]"}], "]"}], "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", "1", ",", "3"}], 
                  "]"}], ",", 
                 RowBox[{"Insert", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"p", "[", 
                    RowBox[{"[", 
                    RowBox[{"t", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "]"}], "]"}], "[", 
                    RowBox[{"[", "3", "]"}], "]"}], ",", "1", ",", "3"}], 
                  "]"}]}], "}"}], ",", 
               RowBox[{
                RowBox[{"IdentityMatrix", "[", "3", "]"}], "[", 
                RowBox[{"[", "r", "]"}], "]"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"res", "=", 
             RowBox[{
              RowBox[{"a", "*", 
               RowBox[{"x", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "+", 
              RowBox[{"b", "*", 
               RowBox[{"x", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "+", "c"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"Break", "[", "]"}], ";"}]}], "\[IndentingNewLine]", 
          "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", "res"}], "\[IndentingNewLine]", ")"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"487f44ee-a472-4557-a31e-4531ab33891b"],

