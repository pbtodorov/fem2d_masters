Cell[BoxData[
 RowBox[{
  RowBox[{"setUpMeshForCpp", "[", 
   RowBox[{"nodes_", ",", " ", "elements_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "i", ",", "el", ",", "configFile", ",", " ", "configLines", ",", 
      "sourceElement", ",", " ", "seismographNode", ",", " ", "updatedLines", 
      ",", "sourcep", ",", "eps", ",", "replacements", ",", "seismographn", 
      ",", " ", "sourcePointString"}], "}"}], ",", 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"el", "=", "elements"}], ";", "\[IndentingNewLine]", 
      RowBox[{"el", " ", "-=", "1"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
       "\"\<D:\\\\Serious\\\\FMI\\\\\:041c\:0430\:0433\:0438\:0441\:0442\:044a\
\:0440\\\\\:0414\:0438\:043f\:043b\:043e\:043c\:0435\:043d \:0441\:0435\:043c\
\:0435\:0441\:0442\:044a\:0440\\\\FEM2D_config\\\\nodes.csv\>\"", ",", 
        "nodes", ",", "\"\<CSV\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{
       "\"\<D:\\\\Serious\\\\FMI\\\\\:041c\:0430\:0433\:0438\:0441\:0442\:044a\
\:0440\\\\\:0414\:0438\:043f\:043b\:043e\:043c\:0435\:043d \:0441\:0435\:043c\
\:0435\:0441\:0442\:044a\:0440\\\\FEM2D_config\\\\elements.csv\>\"", ",", 
        "el", ",", "\"\<CSV\>\""}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "\"\<Exported nodes and elements\>\"", "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"eps", "=", 
