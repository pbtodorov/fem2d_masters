Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Third", " ", 
     RowBox[{"row", ":", "difference"}]}], ",", 
    RowBox[{"with", " ", "its", " ", "own", " ", "color", " ", "scaling"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"rowDifference", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Plot3D", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"aalyticalInterp", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "[", 
           RowBox[{"x", ",", "y"}], "]"}], "-", 
          RowBox[{
           RowBox[{"numericalInterp", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "[", 
           RowBox[{"x", ",", "y"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "xMin", ",", "xMax"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"y", ",", "yMin", ",", "yMax"}], "}"}], ",", 
         RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
