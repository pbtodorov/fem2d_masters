Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"First", " ", 
    RowBox[{"row", ":", "analytic"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"rowAnalytic", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"plotStyle", "[", 
        RowBox[{"aalyticalInterp", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "aalyticalInterp", "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Second", " ", 
     RowBox[{"row", ":", "numerical"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rowNumerical", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"plotStyle", "[", 
        RowBox[{"numericalInterp", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "numericalInterp", "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9636732653553095`*^9, 3.963673273535254*^9}, {
  3.9636735873598127`*^9, 3.9636735926669703`*^9}, {3.964364070912669*^9, 
