           RowBox[{"10", "^", 
            RowBox[{"-", "3"}]}], " ", "scale"}], "*)"}], 
         RowBox[{"ColorFunction", "\[Rule]", "\"\<ThermometerColors\>\""}], 
         ",", 
         RowBox[{"Mesh", "\[Rule]", "None"}], ",", 
         RowBox[{"ImageSize", "\[Rule]", "285"}], ",", 
         RowBox[{"PlotPoints", "\[Rule]", "50"}], ",", 
