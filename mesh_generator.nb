Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"calculatePlotXY", "[", 
     RowBox[{"q_", ",", "nodes_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "n", ",", " ", "tablex", ",", " ", "tabley", ",", "T", ",", " ", 
        "timestep"}], "}"}], ",", 
      RowBox[{"(", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"T", "=", 
         RowBox[{"Length", "[", "q", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ihat", "=", 
         RowBox[{"Table", "[", 
          RowBox[{"0", ",", "2", ",", 
           RowBox[{"Length", "[", "q", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "nodes", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"j", "=", "1"}], ",", 
          RowBox[{"j", "\[LessEqual]", "T"}], ",", 
          RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"tablex", " ", "=", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"nodes", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ",", 
                RowBox[{"q", "[", 
                 RowBox[{"[", 
                  RowBox[{"j", ",", 
                   RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"2", "*", "n"}], "+"}], "*)"}], 
                   RowBox[{
                    RowBox[{"2", "*", "i"}], "-", "1"}]}], "]"}], "]"}]}], 
               "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", 
                RowBox[{"Length", "[", "nodes", "]"}]}], "}"}]}], "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{"tabley", " ", "=", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"nodes", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], ",", 
                RowBox[{"q", "[", 
                 RowBox[{"[", 
                  RowBox[{"j", ",", 
                   RowBox[{"(*", 
                    RowBox[{
                    RowBox[{"2", "*", "n"}], "+"}], "*)"}], 
                   RowBox[{"2", "*", "i"}]}], "]"}], "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", 
                RowBox[{"Length", "[", "nodes", "]"}]}], "}"}]}], "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"ihat", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "j"}], "]"}], "]"}], " ", "=", " ", 
            RowBox[{"Interpolation", "[", 
             RowBox[{"tablex", ",", 
              RowBox[{"InterpolationOrder", "\[Rule]", "1"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"ihat", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "j"}], "]"}], "]"}], " ", "=", " ", 
            RowBox[{"Interpolation", "[", 
             RowBox[{"tabley", ",", 
              RowBox[{"InterpolationOrder", "\[Rule]", "1"}]}], "]"}]}], 
           ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        "ihat"}], "\[IndentingNewLine]", ")"}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"nodes", "[", 
    RowBox[{"[", "133", "]"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9628809642534523`*^9, 3.962880985727544*^9}, {
   3.962881217328657*^9, 3.962881218082876*^9}, {3.962881304760382*^9, 
