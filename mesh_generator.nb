Cell[BoxData[{
 RowBox[{"mu", "=", 
  RowBox[{"Mean", "[", "allEdgeLengths", "]"}]}], "\n", 
 RowBox[{"sigma", "=", 
  RowBox[{"StandardDeviation", "[", "allEdgeLengths", "]"}]}], "\n", 
 RowBox[{
  RowBox[{"X", "=", "77"}], ";"}], "\n", 
 RowBox[{"pCLT", "=", 
  RowBox[{"CDF", "[", 
   RowBox[{
    RowBox[{"NormalDistribution", "[", 
     RowBox[{
      RowBox[{"10", "*", "mu"}], ",", 
      RowBox[{
       RowBox[{"Sqrt", "[", "10", "]"}], "*", "sigma"}]}], "]"}], ",", "X"}], 
   "]"}]}]}], "Input",
