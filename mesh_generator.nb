Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"assume", " ", "you", " ", "already", " ", 
     RowBox[{"have", ":", "nodes"}]}], ",", "elements"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "1", "\:fe0f\:20e3", " ", "Compute", " ", "all", " ", "interior", " ", 
    "edge", " ", "lengths"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"edgeLengths", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{
         RowBox[{"nodes", "[", 
          RowBox[{"[", 
           RowBox[{"edge", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "-", 
         RowBox[{"nodes", "[", 
          RowBox[{"[", 
           RowBox[{"edge", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"edge", ",", "elements"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "2", "\:fe0f\:20e3", " ", "Find", " ", "indices", " ", "of", " ", 
     "boundary", " ", "nodes"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"boundaryNodes", "=", 
     RowBox[{"Flatten", "@", 
      RowBox[{"Position", "[", 
       RowBox[{"nodes", ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x_", ",", "y_"}], "}"}], "/;", 
         RowBox[{
          RowBox[{"x", "\[Equal]", "0"}], "||", 
          RowBox[{"x", "\[Equal]", "500"}], "||", 
          RowBox[{"y", "\[Equal]", "0"}], "||", 
          RowBox[{"y", "\[Equal]", "900"}]}]}]}], "]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3", "\:fe0f\:20e3", " ", "Build", " ", "all", " ", "edges", " ", 
     RowBox[{"(", 
      RowBox[{"each", " ", "triangle", " ", "contributes", " ", "3"}], 
      ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allEdges", "=", 
     RowBox[{"Sort", "/@", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"elements", "/.", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "\[RuleDelayed]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"a", ",", "b"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"b", ",", "c"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"c", ",", "a"}], "}"}]}], "}"}]}]}], ",", "1"}], 
       "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "4", "\:fe0f\:20e3", " ", "Select", " ", "only", " ", "boundary", " ", 
     "edges", " ", 
     RowBox[{"(", 
      RowBox[{"both", " ", "nodes", " ", "on", " ", "the", " ", "border"}], 
      ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"boundaryEdges", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"allEdges", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{"boundaryNodes", ",", 
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "&&", 
         RowBox[{"MemberQ", "[", 
          RowBox[{"boundaryNodes", ",", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "&"}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "5", "\:fe0f\:20e3", " ", "Compute", " ", "their", " ", "lengths"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"boundaryEdgeLengths", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Norm", "[", 
        RowBox[{
         RowBox[{"nodes", "[", 
          RowBox[{"[", 
           RowBox[{"e", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "-", 
         RowBox[{"nodes", "[", 
          RowBox[{"[", 
           RowBox[{"e", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"e", ",", "boundaryEdges"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "6", "\:fe0f\:20e3", " ", "Combine", " ", "with", " ", "interior", " ", 
     "lengths"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"allEdgeLengths", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"edgeLengths", ",", "boundaryEdgeLengths"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
