Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ricker", "[", 
    RowBox[{"t_", ",", "f0_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "tshift"}], "}"}], ",", 
     RowBox[{"(", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"tshift", "=", 
        RowBox[{"1.", "/", "f0"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"a", "=", 
        RowBox[{"Pi", "*", "f0", "*", 
         RowBox[{"(", 
          RowBox[{"t", "-", "tshift"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"2", "*", 
           RowBox[{"a", "^", "2"}]}]}], ")"}], "*", 
        RowBox[{"Exp", "[", 
         RowBox[{"-", 
          RowBox[{"a", "^", "2"}]}], "]"}]}]}], "\[IndentingNewLine]", 
      ")"}]}], "]"}]}]}]], "Input",
