Cell[BoxData[
 RowBox[{
  RowBox[{"calculateSourceVx", "[", 
   RowBox[{"x_", ",", "y_", ",", "x0_", ",", "y0_", ",", "radius_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dist", "=", 
       RowBox[{"EuclideanDistance", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x0", ",", "y0"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"dist", ">", "radius"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "0", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"-", "2"}], "*", 
       RowBox[{"(", 
        RowBox[{"y", "-", "y0"}], ")"}], "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"dist", "^", "2"}]}], "/", 
         RowBox[{"radius", "^", "2"}]}], "]"}]}]}], "\[IndentingNewLine]", 
     ")"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9631954495738754`*^9, 3.9631956482217445`*^9}, 
   3.9631958955132384`*^9},
 CellLabel->"In[25]:=",ExpressionUUID->"ce84c37f-397a-4e92-a7f2-93a489695a3a"],

