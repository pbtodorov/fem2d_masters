Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"T", "=", "2.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"dT", "=", 
  RowBox[{"T", "/", 
   RowBox[{"Length", "[", 
    RowBox[{"matrixFreqAnalysis", "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{"1", ";;", 
        RowBox[{"-", "1"}]}], ",", "1"}], "]"}], "]"}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fs", "=", 
   RowBox[{"T", "/", "dT"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fftX", "=", 
   RowBox[{"Fourier", "[", 
    RowBox[{"matrixFreqAnalysis", "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{"1", ";;", 
        RowBox[{"-", "1"}]}], ",", "1"}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"Length", "[", 
    RowBox[{"matrixFreqAnalysis", "[", 
     RowBox[{"[", 
      RowBox[{
       RowBox[{"1", ";;", 
        RowBox[{"-", "1"}]}], ",", "1"}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"freqs", "=", 
   RowBox[{"fs", "*", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", 
       RowBox[{"n", "-", "1"}]}], "]"}], "/", "n"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"half", "=", 
   RowBox[{"Floor", "[", 
    RowBox[{"n", "/", "200"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"freqsHalf", "=", 
   RowBox[{"freqs", "[", 
    RowBox[{"[", 
     RowBox[{"1", ";;", "half"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fftHalf", "=", 
   RowBox[{"Abs", "[", 
    RowBox[{"fftX", "[", 
     RowBox[{"[", 
      RowBox[{"1", ";;", "half"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"freqsHalf", ",", "fftHalf"}], "}"}], "]"}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<Frequency (Hz)\>\"", ",", "\"\<Amplitude\>\""}], "}"}]}], 
   ",", 
   RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], "\n"}], "Input",
 CellChangeTimes->{{3.9727954640598154`*^9, 3.9727954705045633`*^9}, {
